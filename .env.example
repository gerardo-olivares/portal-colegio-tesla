# =============================================================
#  Variables de entorno — Portal Colegio Tesla
#  1. Copia este archivo como ".env":   cp .env.example .env
#  2. Llena los valores reales.
#  3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# =============================================================

# --- Servidor ---
# Puerto donde escucha Express (Render asigna el suyo automáticamente)
PORT=3000
# development | production | test
NODE_ENV=development

# --- Base de datos (MongoDB) ---
# Local:  mongodb://127.0.0.1:27017/colegio_tesla
# Atlas:  mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/colegio_tesla
MONGODB_URI=mongodb://127.0.0.1:27017/colegio_tesla

# --- Autenticación JWT ---
# Clave secreta larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
# Tiempo de validez del token (ej. 15m, 8h, 1d)
JWT_EXPIRES_IN=8h

# --- CORS ---
# Orígenes externos permitidos, separados por coma
# (el frontend incluido en /public se sirve desde el mismo origen y no necesita estar aquí)
CORS_ORIGINS=http://localhost:5500,https://gerardo-olivares.github.io

# --- Usuario administrador inicial (lo crea "npm run seed") ---
ADMIN_NOMBRE=Administración Colegio Tesla
ADMIN_EMAIL=admin@colegiotesla.mx
ADMIN_PASSWORD=CambiaEstaContraseña123
