{
  "name": "portal-colegio-tesla",
  "version": "1.0.0",
  "description": "Portal administrativo del Colegio Tesla: API RESTful con Express, MongoDB y JWT + frontend en HTML, CSS y JavaScript",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "jwt",
    "api-rest",
    "colegio"
  ],
  "author": "Gerardo Olivares Mijares",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  }
}
